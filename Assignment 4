    "    'E': ['G'],\n",
    "    'F': [],\n",
    "    'G': []\n",
    "}\n",
    "\n",
    "# Define DFS\n",
    "def dfs(graph, node, visited=None, traversal=None):\n",
    "    if visited is None:\n",
    "        visited = set()\n",
    "    if traversal is None:\n",
    "        traversal = []\n",
    "\n",
    "    visited.add(node)\n",
    "    traversal.append(node)\n",
    "\n",
    "    for neighbor in graph[node]:\n",
    "        if neighbor not in visited:\n",
    "            dfs(graph, neighbor, visited, traversal)\n",
    "\n",
    "    return traversal\n",
    "\n",
    "result = dfs(graph, 'A')\n",
    "\n",
    "print(\"DFS Traversal\")\n",
    "print(\" -> \".join(result))\n",
    "\n",
    "G = nx.DiGraph()\n",
    "\n",
    "for node in graph:\n",
    "    for neighbor in graph[node]:\n",
    "        G.add_edge(node, neighbor)\n",
    "\n",
    "pos = {\n",
    "    'A': (0, 3),\n",
    "    'B': (-1, 2),\n",
